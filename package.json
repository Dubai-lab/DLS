{
  "name": "football-league-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Football League Hub - multi-tenant platform for running football leagues",
  "scripts": {
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "migrate": "node scripts/migrate-to-supabase.mjs",
    "seed:admins": "node scripts/seed-admins.mjs",
    "serve": "node --watch-path=./api --watch-path=./scripts scripts/serve.mjs",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#0a0e14' --iconBackgroundColorDark '#0a0e14' --splashBackgroundColor '#0a0e14' --splashBackgroundColorDark '#0a0e14'",
    "test": "node scripts/test-competition.mjs && node scripts/test-dialog.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  }
}
