# Secrets - never commit
.env
.env.*
!.env.example
ADMIN-PASSWORDS.txt

# Database snapshots. These contain player phone numbers and push
# subscriptions, so they stay off the remote.
backups/

# Dependencies
node_modules/

# Vercel
.vercel/

# ---------------------------------------------------------------------------
# Capacitor
#
# The android/ and ios/ project folders ARE committed - Codemagic builds from
# them and they carry the signing and capability configuration. What is ignored
# is everything `npx cap sync` regenerates or a build produces.
# ---------------------------------------------------------------------------

# web assets copied out of www/ at sync time
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
ios/App/App/public/
ios/App/App/capacitor.config.json

# FCM config - injected from Codemagic env at build time
android/app/google-services.json
ios/App/App/GoogleService-Info.plist

# Gradle / Android build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/
*.apk
*.aab
*.keystore
*.jks

# Xcode / CocoaPods build output
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/build/
ios/App/Podfile.lock
DerivedData/
*.ipa
*.xcarchive

# OS / editor
Thumbs.db
.DS_Store

# Generated for pasting into Vercel; delete once set
vercel-env.txt
